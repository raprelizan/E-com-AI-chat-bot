{%- comment -%}
  Shopify AI Voice Sales Assistant snippet
  Usage in theme.liquid:
  {% render 'ai-voice-assistant', api_base: 'https://your-backend.example.com' %}
{%- endcomment -%}

{%- if request.page_type == 'product' -%}
  <link rel="stylesheet" href="{{ 'voice-assistant.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ 'voice-assistant.css' | asset_url }}"></noscript>

  <script>
    window.ShopifyVoiceAssistantConfig = {
      apiBase: {{ api_base | default: 'http://localhost:8787' | json }},
      lang: 'ar-DZ',
      ttsLang: 'ar'
    };

    (function () {
      function loadAssistant() {
        var s = document.createElement('script');
        s.src = {{ 'voice-assistant.js' | asset_url | json }};
        s.defer = true;
        document.head.appendChild(s);
      }

      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadAssistant, { timeout: 1500 });
      } else {
        setTimeout(loadAssistant, 350);
      }
    })();
  </script>
{%- endif -%}
